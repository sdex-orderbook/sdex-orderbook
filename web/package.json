{
  "name": "@sik/sdex-orderbook-web",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "SDEX order book and trade aggregations rebuilt from Stellar ledger data, compared with Horizon at the same ledger.",
  "scripts": {
    "demo:data": "node scripts/build-data.ts",
    "dev": "vite",
